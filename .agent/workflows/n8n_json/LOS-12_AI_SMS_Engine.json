        "functionCode": "const body = items[0].json.body || items[0].json;\nconst from = (body.From || body.from || '').replace('+1','').replace(/\\D/g,'');\nconst last10 = from.slice(-10);\nitems[0].json.from_number = from;\nitems[0].json.last10 = last10;\nitems[0].json.sms_body = body.Body || body.body || '';\nreturn items;"
