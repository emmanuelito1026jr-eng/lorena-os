    {
      "parameters": {
        "functionCode": "const lead = $node['Find Lead'].json || $node['Create Lead'].json || {};\nconst history = $node['Get History'].json ? [$node['Get History'].json] : [];\nconst sms = $node['Extract SMS'].json.sms_body;\nconst lang = lead.preferred_language || 'en';\n\nlet historyText = '';\nif (Array.isArray(history) && history.length > 0) {\n  // Format last 10 messages\n  historyText = history.slice(0, 10).reverse().map(m => {\n    const who = m.direction === 'inbound' ? '[LEAD]' : '[LORENA]';\n    return who + ': ' + (m.content || '').substring(0, 200);\n  }).join('\\n');\n}\n\nconst prompt = `You are Lorena's AI texting assistant for El Paso real estate.\n\nCONVERSATION HISTORY:\n${historyText || 'No previous messages.'}\n\nLATEST MESSAGE FROM LEAD: ${sms}\n\nLEAD PROFILE:\nName: ${lead.first_name || 'Unknown'} ${lead.last_name || ''}, Score: ${lead.score || 0}, Status: ${lead.status || 'new_lead'}\nBudget: $${lead.budget_min || '?'}-$${lead.budget_max || '?'}, Areas: ${(lead.preferred_areas || []).join(', ') || 'unknown'}\nIs Seller: ${lead.is_seller || false}, Timeline: ${lead.buyer_timeline || lead.seller_timeline || 'unknown'}\nLanguage: ${lang}\n\nRULES:\n1. Respond in ${lang === 'es' ? 'Spanish' : lang === 'both' ? 'English then Spanish' : 'English'}. Under 300 chars.\n2. Qualify: discover WHO, WHAT (buy/sell, type, budget), WHEN (timeline), WHERE (neighborhoods), WHY (motivation)\n3. When 4+ W's answered, suggest scheduling a showing with Lorena\n4. Be warm, conversational, helpful. NOT salesy.\n5. If they want to stop, respect immediately.\n\nOutput ONLY valid JSON:\n{\"reply_text\": \"...\", \"qualification_score\": 0-100, \"is_agent_ready\": boolean, \"extracted_info\": {\"budget_min\": null, \"budget_max\": null, \"preferred_areas\": null, \"buyer_timeline\": null, \"is_seller\": null}, \"agent_ready_summary\": \"summary if is_agent_ready=true else null\"}`;\n\nitems[0].json.claude_body = JSON.stringify({\n  model: \"claude-sonnet-4-5-20250929\",\n  max_tokens: 1000,\n  messages: [{role: \"user\", content: prompt}]\n});\nreturn items;"
      },
      "name": "Build AI Prompt",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1800,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.claude_body }}",
        "options": {}
      },
      "name": "Claude AI Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2000,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "const c = items[0].json.content;\nlet text = c && Array.isArray(c) ? c[0].text : '';\nlet reply = text, score = 0, ready = false, info = {}, summary = null;\ntry {\n  let cl = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const p = JSON.parse(cl);\n  reply = p.reply_text || text;\n  score = p.qualification_score || 0;\n  ready = p.is_agent_ready || false;\n  info = p.extracted_info || {};\n  summary = p.agent_ready_summary || null;\n} catch(e) { reply = text.substring(0, 300); }\nitems[0].json = { reply_text: reply, qualification_score: score, is_agent_ready: ready, extracted_info: info, agent_ready_summary: summary };\nreturn items;"
      },
      "name": "Parse AI Reply",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        2200,
        200
