        ]
      ]
    },
    "Parse Content": {
      "main": [
        [
          {
            "node": "Save Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Content": {
      "main": [
        [
          {
            "node": "Email Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Draft": {
      "main": [
        [
          {
            "node": "Notify",
