    {
      "parameters": {
        "functionCode": "const body = items[0].json.body || items[0].json;\nconst name = body.name || '';\nconst parts = name.split(' ');\nconst firstName = parts[0] || 'Unknown';\nconst lastName = parts.slice(1).join(' ') || '';\nconst email = body.email || '';\nconst phone = body.phone || '';\nconst type = body.type || 'buyer';\nconst source = body.source || 'website';\n\nlet score = 10;\nif (type === 'buyer') score += 5;\nif (type === 'seller') score += 5;\nlet temp = 'cold';\nif (score >= 15) temp = 'cool';\n\nreturn [{\n  json: {\n    firstName, lastName, email, phone,\n    source, type,\n    score, temp,\n    dealType: type === 'seller' ? 'seller' : 'buyer',\n    fullName: name\n  }\n}];"
      },
      "name": "Process Lead",
