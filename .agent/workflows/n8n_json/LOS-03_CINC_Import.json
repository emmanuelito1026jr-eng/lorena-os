      "name": "Split Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const results = [];\nfor (const item of items) {\n  const lead = item.json;\n  const statusMap = {\n    'New Lead': 'new_lead',\n    'Attempted Contact': 'attempted_contact',\n    'Contacted': 'contacted',\n    'Appt. Set': 'appointment_set',\n    'Appt. Met': 'appointment_met',\n    'Active Client': 'active_client',\n    'Pending Client': 'pending_client',\n    'Past Client': 'past_client'\n  };\n  \n  results.push({\n    json: {\n      firstName: lead['First Name'],\n      lastName: lead['Last Name'],\n      email: lead['Email'],\n      phone: lead['Phone'] ? lead['Phone'].replace(/\\D/g, '') : null,\n      source: lead['Source'] === 'Google' ? 'website' : (lead['Source'] || 'cinc').toLowerCase(),\n      status: statusMap[lead['Pipeline Stage']] || 'new_lead',\n      isSeller: (lead['Buyer/Seller'] || '').toLowerCase().includes('seller'),\n      tags: (lead['Labels'] || '').split(',').map(t => t.trim()).filter(t => t),\n      score: 5 + (lead['Phone'] ? 5 : 0) + (lead['Email'] ? 5 : 0) + (lead['Pre-Qualified'] ? 10 : 0),\n      temp: 'cool'\n    }\n  });\n}\nreturn results;"
      },
      "name": "Map Fields",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "tableId": "leads",
        "columns": "email",
        "fieldsUi": {
