    {
      "parameters": {
        "functionCode": "const lead_name = items[0].json.lead_name;\nconst source = items[0].json.source;\nconst lead_type = items[0].json.lead_type;\nconst interest = items[0].json.interest;\nconst budget = items[0].json.budget;\nconst language = items[0].json.language;\n\nconst langInstr = language === 'es' ? 'Write in Spanish.' : (language === 'both' ? 'Write in English first, then Spanish on a new line.' : 'Write in English.');\n\nitems[0].json.claude_body_1 = JSON.stringify({\n  model: \"claude-sonnet-4-5-20250929\",\n  max_tokens: 500,\n  messages: [{\n    role: \"user\",\n    content: `You are Lorena's assistant. Write a first-contact SMS for a ${lead_type} lead in El Paso TX.\nLead: ${lead_name}, Source: ${source}, Interest: ${interest}${budget ? ', Budget: ' + budget : ''}.\n${langInstr} Keep under 160 chars. Warm, NOT salesy. Reference their specific interest. Ask ONE question.\nOutput ONLY valid JSON: {\"sms_text\": \"...\"}`\n  }]\n});\nreturn items;"
      },
