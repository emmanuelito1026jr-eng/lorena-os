              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.claude_body_1 }}",
        "options": {}
      },
      "name": "Claude SMS 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const content = items[0].json.content;\nlet text = '';\nif (content && Array.isArray(content)) {\n  text = content[0].text || '';\n}\n// Try to parse JSON from Claude's response\nlet sms_text = text;\ntry {\n  // Remove markdown code blocks if present\n  let cleaned = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  sms_text = parsed.sms_text || text;\n} catch(e) {\n  // If not valid JSON, use raw text (trim to 300 chars)\n  sms_text = text.substring(0, 300);\n}\nitems[0].json.sms_text = sms_text;\nreturn items;"
      },
      "name": "Parse SMS 1",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
