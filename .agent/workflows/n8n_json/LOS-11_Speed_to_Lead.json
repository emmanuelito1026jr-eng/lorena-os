        "functionCode": "const content = items[0].json.content;\nlet text = content && Array.isArray(content) ? content[0].text : '';\nlet subject = 'Following up on your real estate inquiry';\nlet body = text;\ntry {\n  let cleaned = text.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  subject = parsed.subject || subject;\n  body = parsed.body || body;\n} catch(e) {}\nitems[0].json.email_subject = subject;\nitems[0].json.email_body = body;\nreturn items;"
