{
  "name": "[LOS-13] Zillow Lead Email Parser",
  "nodes": [
    {
      "parameters": {
        "path": "zillow-lead",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "const b = items[0].json.body || items[0].json;\n// Parse Zillow email forward or API payload\nlet name = b.name || b.from_name || '';\nlet email = b.email || b.from_email || '';\nlet phone = b.phone || '';\nlet property = b.property_address || b.subject || '';\nlet message = b.message || b.body || '';\n\n// Try to parse from email body if it's a forward\nif (message && !name) {\n  const nameMatch = message.match(/Name:\\s*(.+)/i);\n  if (nameMatch) name = nameMatch[1].trim();\n  const emailMatch = message.match(/Email:\\s*(.+)/i);\n  if (emailMatch) email = emailMatch[1].trim();\n  const phoneMatch = message.match(/Phone:\\s*([\\d\\-\\(\\)\\+\\s]+)/);\n  if (phoneMatch) phone = phoneMatch[1].trim();\n  const propMatch = message.match(/(?:Property|Address):\\s*(.+)/i);\n  if (propMatch) property = propMatch[1].trim();\n}\n\nconst nameParts = name.split(' ');\nitems[0].json.first_name = nameParts[0] || '';\nitems[0].json.last_name = nameParts.slice(1).join(' ') || '';\nitems[0].json.email = email;\nitems[0].json.phone = phone;\nitems[0].json.property = property;\nitems[0].json.message = message;\nreturn items;"
      },
      "name": "Parse Zillow",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "limit": 1
      },
      "name": "Check Dup",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "37rJREccSDhKtIGi",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "name": "Is New?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        800,
