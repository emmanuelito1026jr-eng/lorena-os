# ============================================
# CLIENT-SAFE variables (VITE_ prefix = bundled into browser JS)
# These are publicly visible — never put secrets here.
# ============================================

# Supabase project URL and anon (public) key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# n8n webhook URL for form submissions
# Replace with your actual n8n Hostinger URL after deployment
VITE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-id

# ============================================
# SERVER-ONLY variables (no VITE_ prefix — never exposed to browser)
# Used by scripts, seed, and Edge Functions only.
# ============================================

# Supabase service role key — FULL database access, bypasses RLS.
# NEVER prefix with VITE_ — that would expose it to every site visitor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ============================================
# MLS / Spark API (used by pull scripts, not bundled into app)
# ============================================
SPARK_API_TOKEN=your-spark-api-token
SPARK_API_FEED_ID=your-spark-feed-id
SPARK_MEMBER_ID=your-spark-member-id

# ============================================
# AI API Keys (Edge Functions — set via Supabase Secrets dashboard)
# ============================================
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key

# ============================================
# SMS & Email (Phase 4 — not yet needed)
# ============================================
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+19154xxxxxx
# SENDGRID_API_KEY=SG.your-sendgrid-key
# OPENAI_API_KEY=sk-...your-openai-key
